#include <iostream>
using namespace std;
int main()
{
    int n;
    cout << "Enter matrix size: ";
    cin >> n;
    if (n <= 0)
    {
        cout << "Invalid size!" << endl;
        return 0;
    }
    int** matrix = new int*[n];

    for (int i = 0; i < n; i++)
    {
        matrix[i] = new int[n];
    }
    cout << "Enter matrix elements:" << endl;
    for (int i = 0; i < n; i++)
    {
        for (int j = 0; j < n; j++)
        {
            cin >> matrix[i][j];
        }
    }
    bool isDiagonal = true;
    for (int i = 0; i < n; i++)
    {
        for (int j = 0; j < n; j++)
        {
            if (i != j && matrix[i][j] != 0)
            {
                isDiagonal = false;
            }
        }
    }
    if (isDiagonal)
        cout << "The matrix is a Diagonal Matrix." << endl;
    else
        cout << "The matrix is NOT a Diagonal Matrix." << endl;
    for (int i = 0; i < n; i++)
    {
        delete[] matrix[i];
    }
    delete[] matrix;
    return 0;
}
