
#include <iostream>
#include <string>
using namespace std;
char* left(const char* target, const int count)
{
    string temp = target;
    int length = temp.length();
    if (count < 0 || count > length)
    {
        return nullptr;
    }
    char* result = new char[count + 1];
    for (int i = 0; i < count; i++)
    {
        result[i] = target[i];
    }
    result[count] = '\0';
    return result;
}
void Destructor(char* p)
{
    delete[] p;
}
int main()
{
    char target[30];
    int count;
    cout << "Enter a string: ";
    cin.getline(target, 30);
    cout << "Enter count: ";
    cin >> count;
    char* substring = left(target, count);
    if (substring == nullptr)
    {
        cout << "Count is out of range!" << endl;
    }
    else
    {
        cout << "Left substring: " << substring << endl;

        Destructor(substring);
    }
    return 0;
}
